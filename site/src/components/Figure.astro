---
// SPDX-License-Identifier: Apache-2.0
// Outlined image with a caption. Used beside every content section.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  caption: string;
}
const { image, alt, caption } = Astro.props;
---
<figure class="figure">
  <div class="frame">
    <Image src={image} alt={alt} widths={[480, 720, 1088]} quality={72} sizes="(min-width: 60rem) 34rem, 100vw" />
  </div>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .figure { margin: 0; }
  .frame { border: 1px solid var(--color-brass); padding: 0.625rem; }
  .frame :global(img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  figcaption {
    margin-top: 0.75rem;
    text-align: center;
    font: italic 500 1rem/1.4 var(--font-display);
    color: var(--color-muted);
  }
</style>
