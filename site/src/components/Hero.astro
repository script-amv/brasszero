---
// SPDX-License-Identifier: Apache-2.0
// Full-viewport painting with a centred kicker, heading and paragraph.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  kicker: string;
  title: string;
}
const { image, alt, kicker, title } = Astro.props;
---
<section class="hero" aria-labelledby="hero-title">
  <Image
    class="backdrop"
    src={image}
    alt={alt}
    widths={[640, 960, 1280, 1600, 2048]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    layout="none"
  />
  <div class="content">
    <p class="kicker">{kicker}</p>
    <h1 id="hero-title">{title}</h1>
    <div class="lede"><slot /></div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    place-items: center;
    overflow: hidden;
    isolation: isolate;
  }
  .hero :global(.backdrop) {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 55% 45%;
  }
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(ellipse at 50% 50%, rgb(21 16 12 / 0.35) 0%, rgb(21 16 12 / 0.78) 70%, var(--color-ink) 100%);
  }
  .content {
    max-width: 56rem;
    padding: 7rem var(--gutter) 5rem;
    text-align: center;
  }
  .kicker { letter-spacing: 0.24em; }
  h1 {
    margin-top: 1.25rem;
    font-size: clamp(2.75rem, 7vw, 6rem);
    line-height: 0.98;
    text-shadow: 0 4px 40px rgb(0 0 0 / 0.6);
  }
  .lede { max-width: 40rem; margin: 1.75rem auto 0; font-size: 1.1875rem; line-height: 1.65; }
  .lede :global(p) { margin: 0; }
</style>
