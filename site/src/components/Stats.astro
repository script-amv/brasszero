---
// SPDX-License-Identifier: Apache-2.0
// Key numbers with short captions on a light band.
interface Props {
  items: { value: string; label: string }[];
  label: string;
  status?: { label: string; updated: Date; checkpoint: number } | undefined;
}
const { items, label, status } = Astro.props;
const updated = status?.updated.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---
<section class="stats" aria-label={label}>
  <div class="inner">
  {status && (
    <div class="status">
      <p class="kicker">{status.label}</p>
      <p class="meta">
        Checkpoint <span class="checkpoint">{status.checkpoint}</span> · Updated <time datetime={status.updated.toISOString().slice(0, 10)}>{updated}</time>
      </p>
    </div>
  )}
  <dl>
    {items.map((item) => (
      <div class="item">
        <dt>{item.label}</dt>
        <dd>{item.value}</dd>
      </div>
    ))}
  </dl>
  </div>
</section>

<style>
  .stats { background: var(--color-paper); color: var(--color-ink); }
  .stats { --on-light-accent: color-mix(in srgb, var(--color-accent) 70%, var(--color-ink)); --on-light-text: color-mix(in srgb, var(--color-ink) 72%, var(--color-paper)); }
  .inner { max-width: 75rem; margin: 0 auto; padding: clamp(2.25rem, 5vw, 3rem) var(--gutter) clamp(3rem, 7vw, 4.5rem); }
  .status {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem 1.5rem;
    padding-bottom: 1.25rem;
    margin-bottom: 2.25rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-ink) 14%, var(--color-paper));
  }
  .status .kicker { color: var(--on-light-accent); }
  .meta { margin: 0; color: var(--on-light-text); }
  .checkpoint { color: var(--on-light-accent); font-weight: 600; }
  dl {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 9.5rem), 1fr));
    gap: 2rem;
  }
  .item { display: flex; flex-direction: column-reverse; justify-content: flex-end; }
  dd { margin: 0; font: 500 clamp(2.75rem, 5vw, 3.75rem)/1 var(--font-display); font-variant-numeric: lining-nums tabular-nums; color: var(--on-light-accent); }
  dt { margin-top: 0.5rem; font-size: 0.95rem; line-height: 1.5; color: var(--on-light-text); }
</style>
