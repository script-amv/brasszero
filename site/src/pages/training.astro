---
// SPDX-License-Identifier: Apache-2.0
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ChartFigure from '../components/ChartFigure.astro';
import Legend from '../components/Legend.astro';
import { getEntry } from 'astro:content';
import data from '../../public/data/training-record.json';
import approved from '../data/claims.json';
const approvedHeadlines = approved.headlines;
import coalbrookdale from '../assets/art/coalbrookdale.jpg';
import lichfield from '../assets/art/os-lichfield.jpg';
import turner from '../assets/art/turner.jpg';
import ironcoal from '../assets/art/ironcoal.jpg';
import { ACTIONS, ACTION_COLORS, SOURCES, SOURCE_LABELS, SOURCE_COLORS, INDUSTRY_LABELS, INDUSTRY_COLORS } from '../charts/training';

const home = await getEntry('home', 'home');
if (!home) throw new Error('src/content/home.md is missing');

const n = (v: number, digits = 1) => v.toLocaleString('en', { maximumFractionDigits: digits, minimumFractionDigits: digits });
const { meta, score_mean, windows, record } = data;
const firstMean = score_mean[0]!;
const lastMean = score_mean.at(-1)!;
const firstW = windows[0]!;
const lastW = windows.at(-1)!;
const exported = new Date(meta.exported).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const recSources = SOURCES.map((s, i) => ({ s, label: SOURCE_LABELS[s]!, color: SOURCE_COLORS[i]!, vp: (record.sources as Record<string, number>)[s] ?? 0 })).filter((x) => x.vp > 0);
const opponents = record.opponents === 'mixed' ? 'three other AI players' : record.opponents === 'self-play' ? 'copies of itself' : `three ${record.opponents} players`;
---
<BaseLayout
  title="Training record · BrassZero"
  description={`Every recorded AI score across ${meta.latest_update} model updates of BrassZero self-play training, with behaviour and scoring metrics.`}
  ogImage={coalbrookdale}
>
  <SiteHeader slot="header" links={[{ href: '/', label: 'Project' }, { href: '/training', label: 'Training record', current: true }]} />

  <section class="hero" aria-labelledby="page-title">
    <Image class="backdrop" src={coalbrookdale} alt="" widths={[640, 1280, 2048]} sizes="100vw" loading="eager" layout="none" />
    <div class="wrap hero-content">
      <p class="kicker">Training record · Updates 0–{meta.latest_update}</p>
      <h1 id="page-title">{approvedHeadlines.score}</h1>
      <p class="lede">
        Each dot is one AI seat’s final score in a recorded game: {meta.ai_seat_scores.toLocaleString('en')} scores
        from {meta.games.toLocaleString('en')} games, on the main line and its experiment branches. The line is the mean per {meta.score_window} model updates.
      </p>
      <div class="status">
        <p class="kicker">{home.data.status.label}</p>
        <p>Main line at checkpoint <span class="accent">{home.data.status.checkpoint}</span> · Data exported {exported} · Headline measurements dated {approved.as_of}</p>
      </div>
      <ChartFigure chart="score" height="26rem" caption={`Updates ${firstMean.lo}–${firstMean.hi}: ${firstMean.n.toLocaleString('en')} scores, mostly evaluations of the untrained model. Updates ${lastMean.lo}–${lastMean.hi}: ${lastMean.n.toLocaleString('en')} scores.`}>
        <Legend slot="legend" items={[
          { label: 'Training game score', color: 'var(--color-paper)', shape: 'dot' },
          { label: 'Evaluation game score', color: 'var(--color-brass)', shape: 'dot' },
          { label: `Mean per ${meta.score_window} updates`, color: 'var(--color-accent)', shape: 'line' },
        ]} />
      </ChartFigure>
    </div>
  </section>

  <section class="wrap block" aria-labelledby="behaviour">
    <p class="kicker">Behaviour</p>
    <h2 id="behaviour">{approvedHeadlines.actions}</h2>
    <p class="lede">Early models often passed their turn. By updates {lastW.lo}–{lastW.hi} those actions go to building, developing and selling.</p>
    <ChartFigure chart="actions" height="24rem" caption={`Share of each main action among all main actions, per window of ${meta.window} updates. Follow-up actions are excluded.`}>
      <Legend slot="legend" items={ACTIONS.map((a, i) => ({ label: a, color: ACTION_COLORS[i]! }))} />
    </ChartFigure>
  </section>

  <hr class="divider" />

  <section class="wrap block" aria-labelledby="eras">
    <p class="kicker">Era by era</p>
    <h2 id="eras">Borrowing, income and networks in each era</h2>
    <p class="lede">The same measures for the Canal era and the Rail era, on shared scales. Income at the end of the Rail era rose from {n(firstW.income.rail!)} to {n(lastW.income.rail!)}.</p>
    <p>Sample sizes for each strategy measure appear in the downloadable window data. Each window reports its seat-game and policy counts.</p>
    <div class="eras">
      {[
        { era: 'canal', num: 'I', name: 'Canal era', image: lichfield, alt: 'Ordnance Survey map of Lichfield, 1830s' },
        { era: 'rail', num: 'II', name: 'Rail era', image: turner, alt: 'Rain, Steam and Speed, Turner, 1844' },
      ].map((e) => (
        <div class="era">
          <div class="era-head">
            <Image src={e.image} alt={e.alt} widths={[240]} sizes="120px" class="thumb" />
            <div>
              <p class="kicker">Era {e.num}</p>
              <h3>{e.name}</h3>
            </div>
          </div>
          <ChartFigure chart="loans" era={e.era} title="Loans per seat-game" height="16rem" />
          <ChartFigure chart="income" era={e.era} title="Income level at era end" height="16rem" />
          <ChartFigure chart="unflipped" era={e.era} title="Unflipped industries at era end" height="16rem" />
          <ChartFigure chart="network" era={e.era} title="Link VP per link built" height="16rem" />
        </div>
      ))}
    </div>
  </section>

  <hr class="divider" />

  <section class="wrap block" aria-labelledby="sources">
    <p class="kicker">Scoring sources</p>
    <h2 id="sources">Where the points come from</h2>
    <p class="lede">Iron works and rail links carry most of the score. Breweries grew from {n(firstW.sources!.brewery!)} to {n(lastW.sources!.brewery!)} points per game.</p>
    <ChartFigure chart="sources" height="25rem" caption={`Victory points by source in each policy’s highest-scoring game, averaged per window of ${meta.window} updates.`}>
      <Legend slot="legend" items={SOURCES.map((s, i) => ({ label: SOURCE_LABELS[s]!, color: SOURCE_COLORS[i]! }))} />
    </ChartFigure>
  </section>

  <hr class="divider" />

  <section class="wrap block" aria-labelledby="construction">
    <p class="kicker">Construction</p>
    <h2 id="construction">What it builds</h2>
    <div class="pair">
      <ChartFigure chart="built" title="Industries built per seat-game" height="19rem" caption="Successful builds, including tiles later removed or overbuilt.">
        <Legend slot="legend" items={Object.keys(INDUSTRY_LABELS).map((k) => ({ label: INDUSTRY_LABELS[k]!, color: INDUSTRY_COLORS[k]!, shape: 'line' as const }))} />
      </ChartFigure>
      <ChartFigure chart="twice" title="Industry VP scored again in the Rail era" height="16rem" caption="Rail-era points from industry tiles already flipped and scored in the Canal era." />
    </div>
  </section>

  <hr class="divider" />

  <section class="wrap block record" aria-labelledby="record">
    <div class="record-text">
      <p class="kicker">Highest score so far</p>
      <h2 id="record">{approvedHeadlines.record}</h2>
      <p class="lede">Model update {record.update}, an experiment branch from the main line, in an {record.category} game against {opponents}. Breweries and iron works scored {(record.sources?.brewery ?? 0) + (record.sources?.iron ?? 0)} of its {record.vp} points.</p>
      <div class="bar" role="img" aria-label={recSources.map((x) => `${x.label} ${x.vp}`).join(', ')}>
        {recSources.map((x) => <span style={`flex: ${x.vp} 1 0; background: ${x.color}`} title={`${x.label}: ${x.vp}`}></span>)}
      </div>
      <Legend items={recSources.map((x) => ({ label: `${x.label} ${x.vp}`, color: x.color }))} />
    </div>
    <figure class="record-figure">
      <div class="frame"><Image src={ironcoal} alt="Iron and Coal by William Bell Scott, 1861" widths={[480, 960]} sizes="(min-width: 60rem) 28rem, 100vw" /></div>
      <figcaption>William Bell Scott, Iron and Coal, 1861.</figcaption>
    </figure>
  </section>

  <hr class="divider" />

  <section class="wrap block" aria-labelledby="method">
    <p class="kicker">About this data</p>
    <h2 id="method">Sources and definitions</h2>
    <dl class="defs">
      <div><dt>Source</dt><dd>The project’s replay archive: every recorded training and evaluation game with a known model update, on the main line and its experiment branches. Quality-assurance and validation recordings are excluded.</dd></div>
      <div><dt>Seat score</dt><dd>One AI seat’s final victory points in one four-player game.</dd></div>
      <div><dt>Windows</dt><dd>Scores are averaged per {meta.score_window} model updates; behaviour and scoring measures per {meta.window}. Windows not yet complete are left out. Hollow points mark windows with fewer than 20 seat-games.</dd></div>
      <div><dt>Gaps</dt><dd>Some updates have no recorded games. Missing updates are not zero scores.</dd></div>
      <div><dt>Not a strength test</dt><dd>These charts show trends across training. Strength is decided by the pre-declared tests on the roadmap.</dd></div>
      <div><dt>Data</dt><dd><a href="/data/training-record.json" download>Download the data (JSON)</a>, exported {exported}.</dd></div>
    </dl>
  </section>

  <SiteFooter slot="footer" credits={home.data.credits} />
</BaseLayout>

<script>
  import { mount, type TrainingRecord } from '../charts/training';
  fetch('/data/training-record.json')
    .then((r) => r.json() as Promise<TrainingRecord>)
    .then(mount)
    .catch(() => document.querySelectorAll('[data-chart]').forEach((n) => (n.textContent = 'The charts could not load. Download the data below.')));
</script>

<style>
  .wrap { max-width: 75rem; margin-inline: auto; padding-inline: var(--gutter); }
  .block { padding-block: var(--space); }
  h1 { font-size: clamp(2.5rem, 6vw, 4.75rem); margin-top: 1rem; max-width: 18ch; }
  h2 { font-size: clamp(2rem, 4vw, 3.25rem); margin: 0.75rem 0 1rem; }
  .lede { max-width: 42rem; margin: 0 0 2rem; font-size: 1.0625rem; line-height: 1.7; color: color-mix(in srgb, var(--color-paper) 88%, var(--color-ink)); }
  .accent { color: var(--color-accent); font-weight: 600; }

  .hero { position: relative; isolation: isolate; overflow: hidden; }
  .hero :global(.backdrop) { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; object-position: 50% 40%; }
  .hero::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(to bottom, rgb(21 16 12 / 0.7), rgb(21 16 12 / 0.9) 45%, var(--color-ink)); }
  .hero-content { padding-top: 8rem; padding-bottom: var(--space); }
  .hero .lede { margin-top: 1.25rem; }
  .status { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 0.5rem 1.5rem; padding: 1rem 0; margin-bottom: 2rem; border-top: 1px solid var(--color-rule); }
  .status p { margin: 0; }
  .status p:not(.kicker) { color: var(--color-muted); }

  .eras { display: grid; gap: 3rem 4rem; }
  @media (min-width: 60rem) { .eras { grid-template-columns: 1fr 1fr; } }
  .era { display: grid; gap: 2.5rem; align-content: start; }
  .era-head { display: flex; align-items: center; gap: 1.25rem; }
  .era-head h3 { font-size: 2.25rem; margin-top: 0.25rem; }
  .era-head :global(.thumb) { width: 7.5rem; height: 5.25rem; object-fit: cover; border: 1px solid var(--color-brass); padding: 0.25rem; }

  .pair { display: grid; gap: 3rem 4rem; align-items: start; }
  @media (min-width: 60rem) { .pair { grid-template-columns: 3fr 2fr; } }

  .record { display: grid; gap: 3rem 4rem; align-items: start; }
  @media (min-width: 60rem) { .record { grid-template-columns: 1fr 1fr; } .record-text { align-self: center; } }
  .record h2 { font-size: clamp(2.5rem, 5vw, 4rem); }
  .record h2 .accent { font-weight: 500; font-size: 1.6em; }
  .bar { display: flex; gap: 2px; height: 1.75rem; margin-bottom: 1rem; }
  .record-figure { margin: 0; }
  .frame { border: 1px solid var(--color-brass); padding: 0.625rem; }
  .frame :global(img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .record-figure figcaption { margin-top: 0.75rem; text-align: center; font: italic 500 1rem/1.4 var(--font-display); color: var(--color-muted); }

  .defs { display: grid; gap: 1.25rem 3rem; margin: 1rem 0 0; }
  @media (min-width: 48rem) { .defs { grid-template-columns: 1fr 1fr; } }
  .defs dt { font-weight: 600; color: var(--color-paper); }
  .defs dd { margin: 0.25rem 0 0; font-size: 0.9375rem; line-height: 1.6; color: var(--color-muted); }
</style>
